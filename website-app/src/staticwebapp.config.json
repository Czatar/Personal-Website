{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/favicon.ico",
      "/assets/*",
      "/static/*",
      "/manifest.json",
      "/robots.txt",
      "/sitemap.xml",
      "/*.css",
      "/*.js"
    ]
  },
  "mimeTypes": {
    ".js": "text/javascript",
    ".css": "text/css"
  }
}
