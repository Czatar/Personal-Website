{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/favicon.ico",
      "/assets/*",
      "/scripts/*",
      "/styles/*",
      "*.js",
      "*.css",
      "*.png",
      "*.jpg",
      "*.jpeg",
      "*.gif",
      "*.svg",
      "*.woff",
      "*.woff2",
      "*.ttf"
    ]
  },
  "routes": [
    {
      "route": "/*",
      "headers": {
        "cache-control": "no-store"
      }
    }
  ]
}